---
/**
 * Client quotes. Keep it to two or three short ones; `company` is optional.
 *
 * Quotes marked `placeholder: true` are dummy copy and are left off the page.
 * To publish one, replace its text with a real client quote and remove the
 * flag. With a single quote, the card spans a readable measure instead of a
 * one-third column.
 */
interface Testimonial {
	quote: string;
	name: string;
	company?: string;
	placeholder?: boolean;
}

const testimonials: Testimonial[] = [
	{
		quote:
			"I was working under such a tight deadline, and I was so worried that I'd be unable to get the project finished in time. Seb came in, rolled his sleeves up, and absolutely blew me away with how quick and efficient he was. From the timeline arrangement to the sound layering to the colour grade, he handled it all expertly.",
		name: 'Cameron Walker',
		company: 'Short Walk Studios',
	},
	{
		quote:
			'[Placeholder] The grade completely lifted our footage. Clear communication, thoughtful notes, and a cut we were proud to put in front of our audience.',
		name: 'Client Name',
		company: 'Company Name',
		placeholder: true,
	},
	{
		quote:
			"[Placeholder] He edits like a filmmaker. Every change had a reason behind it, and the pacing is what sold the piece.",
		name: 'Client Name',
		placeholder: true,
	},
];

const approved = testimonials.filter((t) => !t.placeholder);
const hidden = testimonials.length - approved.length;

if (hidden > 0) {
	console.info(`[Testimonials] ${hidden} placeholder quote(s) hidden from the page.`);
}
---

{
	approved.length > 0 && (
		<section class="section" id="testimonials" aria-labelledby="testimonials-title">
			<div class="container">
				<h2 id="testimonials-title" class="t-headline section-header" data-reveal>
					What clients say
				</h2>

				<ul
					class:list={['list-reset', approved.length > 1 ? 'grid grid--3-lg' : 'measure']}
					role="list"
				>
					{approved.map((t) => (
						<li class="card" data-reveal>
							<figure class="stack testimonial">
								<blockquote class="testimonial__quote">
									<p>{t.quote}</p>
								</blockquote>
								<figcaption class="caption">
									<span class="testimonial__name">{t.name}</span>
									{t.company && <>, {t.company}</>}
								</figcaption>
							</figure>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.testimonial {
		--stack-gap: var(--space-3);
		height: 100%;
		justify-content: space-between;
	}

	.testimonial__quote {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
	}

	.testimonial__name {
		font-weight: var(--weight-bold);
		color: var(--color-text);
	}
</style>
