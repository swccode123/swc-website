---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import About from '../components/About.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Services from '../components/Services.astro';
import SelectedWorks from '../components/SelectedWorks.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
	title="SWC — Video Editing & Colour Grading | Sebastian Wells Chavez"
	description="Brisbane-based video editor and colourist specialising in DaVinci Resolve. Corporate, commercial, and film projects — Brisbane and remote."
>
	<Header />
	<main id="main">
		<Hero />
		<Problem />
		<About />
		<HowItWorks />
		<Services />
		<SelectedWorks />
		<ClosingCta />
	</main>
	<Footer />
</BaseLayout>
